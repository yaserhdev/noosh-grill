# ============================================================
# Google Places API — for reviews
# ============================================================
# Server-only. Never expose to the client.
#
# 1. Enable the Places API (New) in Google Cloud Console:
#    https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# 2. Create a key in Credentials, restrict it to the Places API
#    and (recommended) restrict by IP to your Vercel deployment.
# 3. Find the Place ID for Noosh Grill:
#    https://developers.google.com/maps/documentation/places/web-service/place-id
#
# If either var is missing, the site falls back to curated reviews only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ============================================================
# Formspree — for contact form
# ============================================================
# Public — safe to expose to the client (Formspree's threat model
# assumes form IDs are visible in HTML).
NEXT_PUBLIC_FORMSPREE_ID=mkgqolqo